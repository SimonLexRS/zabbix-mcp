{
	"manifest_version": 2.0,
	"id": "zabbixagent",
	"type": "module",
	"name": "AI agent",
	"namespace": "ZabbixAgent",
	"version": "0.2.4",
	"author": "Simon Alex Rodriguez",
	"url": "https://github.com/SimonLexRS/zabbix-mcp",
	"description": "Agentic chat for Zabbix through its native MCP server: streaming, tool calls, approval of changes, plans and tasks, with OpenAI-compatible and Anthropic-compatible (Claude) providers. English and Spanish.",
	"actions": {
		"agent.view": {"class": "View", "view": "agent.view", "layout": "layout.htmlpage"},
		"agent.settings": {"class": "SettingsView", "view": "agent.settings", "layout": "layout.htmlpage"},
		"agent.settings.update": {"class": "SettingsUpdate", "layout": "layout.json"},
		"agent.provider.test": {"class": "ProviderTest", "layout": "layout.json"},
		"agent.config": {"class": "Config", "layout": "layout.json"},
		"agent.tools": {"class": "Tools", "layout": "layout.json"},
		"agent.tool": {"class": "ToolCall", "layout": "layout.json"},
		"agent.chat": {"class": "Chat"}
	},
	"assets": {
		"css": ["agent.css"],
		"js": ["agent.js"]
	}
}
